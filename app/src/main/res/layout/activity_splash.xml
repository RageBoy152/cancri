<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background nature image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_nature" />

    <!-- Vignette overlay (dark edges, clear centre) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette" />

    <!-- Centred container, shifted upward -->
    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="120dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo animates first -->
        <ImageView
            android:id="@+id/splashLogoImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0"
            android:contentDescription="Cancri logo"
            android:src="@drawable/ic_cancri_logo" />

        <!-- Text fades in after logo -->
        <TextView
            android:id="@+id/splashLogoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:fontFamily="serif"
            android:text="Cancri"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="italic" />

    </LinearLayout>

</FrameLayout>