<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable spending category row.
    Used four times inside the Spending Breakdown card.
    Populated programmatically in MainActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Category name + amounts row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/catIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lucide_piggy_bank" />

        <TextView
            android:id="@+id/catName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BILLS"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/catAmounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="£0.00 / £0.00"
            android:textColor="@color/green_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Progress bar track -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:background="#BFCCCCCC">

        <!-- Filled portion — width set via layoutParams in code -->
        <View
            android:id="@+id/catBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/bar_green" />

    </FrameLayout>

    <!-- Status label -->
    <TextView
        android:id="@+id/catStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="ON TARGET"
        android:textAllCaps="true"
        android:textColor="@color/green_primary"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
