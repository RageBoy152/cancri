<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable subscription row.
    Inflated dynamically in MainActivity.updateSubscriptionsList().
    Includes a bottom divider that is hidden on the last item.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Row content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Service logo circle -->
        <TextView
            android:id="@+id/subLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Name + billing period -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/subName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spotify"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Billed monthly"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Amount + frequency -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/subAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="£12.99"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="/mo"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider — hidden on last item via MainActivity -->
    <View
        android:id="@+id/subDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

</LinearLayout>