<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background nature image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_nature" />

    <!-- Vignette overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette" />

    <!-- Card -->
    <LinearLayout
        android:id="@+id/onboarding2Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/onboarding_card_shape"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="32dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Cancri logo"
            android:src="@drawable/ic_cancri_logo" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cancri"
            android:textColor="@color/text_white"
            android:textSize="18sp" />

        <!-- Headline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Setting you up for success"
            android:textColor="@color/green_accent"
            android:textSize="26sp"
            android:textFontWeight="400" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To start your journey, please tell us about you"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Name label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="What should we call you?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Name input -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="John Doe"
            android:inputType="textPersonName"
            android:paddingStart="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="15sp" />

        <!-- Next button -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Next"
            android:layout_marginTop="32dp"
            android:textSize="14sp"
            app:backgroundTint="@null"
            android:background="@drawable/button_main_shape"/>

    </LinearLayout>

</FrameLayout>
