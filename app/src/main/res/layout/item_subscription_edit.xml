<?xml version="1.0" encoding="utf-8"?>
<!--
    Subscription row for the edit screen.
    Shows name, amount, type, plus edit and delete buttons.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_shape"
    android:gravity="center_vertical"
    android:orientation="horizontal">


    <!-- Service logo circle -->
    <TextView
        android:id="@+id/editSubLogo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:text="S"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Name + type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/editSubName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spotify"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editSubAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="£12.99"
                android:textColor="@color/green_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editSubType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="/mo (Renews on 15th)"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Edit button -->
    <TextView
        android:id="@+id/btnEditSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:text="Edit"
        android:textColor="@color/green_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Delete button -->
    <TextView
        android:id="@+id/btnDeleteSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:text="Delete"
        android:textColor="@color/bar_red"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>